# =============================================================================
#  model.env  —  everything specific to serving
#  RedHatAI/Qwen2.5-Coder-32B-Instruct-FP8-dynamic on this box.
#  Sourced after common/box.env; := so a real env var still wins for one-offs:
#     MAX_MODEL_LEN=32768 EXTRA_VLLM_ARGS=" " ./serve start
#
#  STATUS: scaffolded 2026-09-01, weights downloading. Every numeric default
#  below is a STARTING POINT, NOT yet a benchmark result — same status
#  gpt-oss-120b/model.env had before its sweep. Run the bench/matrix.yaml
#  sweep once weights are in place and replace these with the winning config.
#  Model-card facts / gotchas / open questions: notes.md
# =============================================================================

# -- identity ----------------------------------------------------------- #
: "${MODEL:=RedHatAI/Qwen2.5-Coder-32B-Instruct-FP8-dynamic}"   # public repo, Apache 2.0
: "${SERVED_NAME:=qwen2.5-coder-32b}"                            # model id clients pass
# CONTAINER defaults to  vllm-<slug>  ;  PORT is per-model so several coexist
: "${PORT:=8003}"   # 8000 qwen3.8, 8001 bge-m3, 8002 gpt-oss, 8003 here, 8004 deepseek-coder-v2-lite

# -- image override: tool-calling needs xgrammar >=0.2.4, the exact same
#    import bug + fix as qwen3.8-27b-fp8 (see that model.env + its
#    docker/Dockerfile.xgrammar024). The bump is generic (an xgrammar import
#    shim, transformers/torch untouched) — reused as-is, not qwen3.8-specific.
#    NOT registry-pullable: if the local image cache loses
#    `vllm-qwen:26.07-xgrammar024`, rebuild it from that Dockerfile before
#    the next start (preflight() would otherwise try to `docker pull` a
#    nonexistent tag).
#    NOTE: box.env already sets VLLM_IMAGE via ":=", so a plain ":=" here
#    is a silent no-op — only replace it while it's still box.env's stock
#    default, so a one-off  VLLM_IMAGE=... ./serve start  still wins.
if [ "${VLLM_IMAGE}" = "nvcr.io/nvidia/vllm:26.07-py3" ]; then
  VLLM_IMAGE="vllm-qwen:26.07-xgrammar024"
fi

# -- architecture facts (not tunable — context for the knobs below) ----- #
#  Qwen2ForCausalLM, DENSE (not MoE), 64 layers, hidden 5120, 40 Q / 8 KV
#  heads, head_dim 128. FULL attention on every layer — unlike qwen3.8's
#  hybrid mostly-linear-attention stack — so KV cost per token is high:
#  ~128 KiB/token at fp8 KV (2 * 64 layers * 8 kv_heads * 128 head_dim * 1 B)
#  => ~16 GiB for one full-length 131072-token sequence. Budget GPU_MEM_UTIL
#  with that in mind; this is NOT qwen3.8's KV math.
#  No MTP head (no speculative decoding). No vision tower (text-only).
#  Quant: compressed-tensors "float-quantized" — W8A8, channel weights +
#  DYNAMIC per-token activations, lm_head stays BF16. Read from the
#  checkpoint — do NOT pass --quantization (same rule as qwen3.8's fp8 /
#  gpt-oss's mxfp4).

# -- tuned serving knobs (STARTING POINT — see bench/matrix.yaml) ------- #
#  1. Context 131072 via STATIC YaRN. Native max_position_embeddings is
#     32768, rope_scaling is null in the checkpoint. This image's vLLM
#     (0.24.0) has NO --rope-scaling flag (verified: `vllm serve --help=all`)
#     — the override goes through --hf-overrides instead. Qwen only validated
#     Qwen2.5-Coder to 131072 (factor=4); the sweep also probes a
#     262144/factor=8 config (ctx_256k) purely as a data point — adopt it as
#     default ONLY if KV-pool / TTFT / correctness numbers convince.
#     VERIFIED 2026-09-01: /v1/models shows 131072, and a needle at ~token
#     4000 of a 106,939-token prompt was retrieved correctly (YaRN really
#     extends attention). `rope_type` is the accepted key.
: "${MAX_MODEL_LEN:=131072}"
#  Plain assignment (not :=), same reasoning as the VLLM_IMAGE override
#  above — so a one-off  EXTRA_VLLM_ARGS=... ./serve start  still wins.
#  COMPACT JSON, no spaces: lib.sh word-splits EXTRA_VLLM_ARGS on IFS, any
#  space would break the value into separate argv entries.
if [ -z "${EXTRA_VLLM_ARGS:-}" ]; then
  EXTRA_VLLM_ARGS='--hf-overrides {"rope_scaling":{"rope_type":"yarn","factor":4.0,"original_max_position_embeddings":32768}}'
fi

#  2. KV cache dtype fp8: STARTING POINT (mirrors qwen3.8 / gpt-oss wins).
#     This checkpoint's quantization_config has kv_cache_scheme: null — no
#     k/v_scale in the checkpoint, scale 1.0, same unmeasured-accuracy caveat
#     as qwen3.8-27b-fp8. Sweep auto vs fp8 (kv_sweep).
: "${KV_CACHE_DTYPE:=fp8}"

#  3. gpu-memory-utilization 0.62: sized for "solo + bge-m3" — qwen3.8-27b
#     is STOPPED while this model runs on-demand (see README). MEASURED at
#     0.62 (first start): 32.2 GiB weights + 39.34 GiB KV pool = 322,288
#     tokens = 2.46x concurrency @ 131072 (i.e. ~16 GiB per full-length
#     sequence — full attention, unlike qwen3.8). 2.46x is thin; the sweep's
#     context_scaling / seqs_sweep decide whether to raise this or accept
#     lower effective concurrency for a 1–2 user on-demand model.
#     >>> qwen3.8-27b-fp8 must be stopped before starting this model. <<<
: "${GPU_MEM_UTIL:=0.62}"

#  4. max-num-seqs 8: starting guess. On-demand single/few-user coding model,
#     not a batch deployment — likely well below qwen3.8's 32. Sweep 1/4/8/16.
: "${MAX_NUM_SEQS:=8}"

# -- no speculative decoding: dense checkpoint, no MTP/EAGLE head --------- #
: "${MTP_TOKENS:=0}"

# -- vision / multimodal: text-only, no tower either way ----------------- #
: "${LANGUAGE_MODEL_ONLY:=1}"
: "${MM_IMAGE_LIMIT:=0}"
: "${MM_VIDEO_LIMIT:=0}"

# -- serving parser plugins -------------------------------------------- #
#  Not a thinking model — no reasoning channel. REASONING_PARSER stays
#  EMPTY: lib.sh omits --reasoning-parser entirely when it's empty (see
#  lib.sh header). Do NOT point it at qwen3's parser — there is no
#  reasoning_start/end token for it to find.
: "${REASONING_PARSER:=}"
#  Tool calling: `hermes` is Qwen2.5's documented format and the right
#  parser. CAVEAT (verified 2026-09-01): with tool_choice:"auto" this Coder
#  model emits the wrong wrapper (<tools>{json}</tools> instead of
#  <tool_call>…) ~100% of the time -> hermes finds nothing, call falls
#  through as content. tool_choice:"required"/named works (guided decoding).
#  Known Qwen2.5-Coder quirk, not fixable via serving config. Kept enabled
#  (required/named still useful; pure code-gen unaffected). See notes.md.
: "${TOOL_CALL_PARSER:=hermes}"

# -- prefix caching: ON (starting point) ------------------------------- #
#  Coding workloads = large recurring context (open files, repo tree, system
#  prompt). Expected to win like it did for qwen3.8's agent_turn_* workload
#  (prefix_cache_ab: -25/-27% TTFT, +22% throughput under concurrency).
#  Re-verify with this model's own prefix_cache_ab suite.
: "${PREFIX_CACHING:=1}"

# -- misc ------------------------------------------------------------- #
: "${STARTUP_TIMEOUT:=1200}"   # ~34 GiB weights — similar cold-load ballpark to qwen3.8's 28 GiB

# NOT set on purpose:
#   --quantization fp8   read from the checkpoint's quantization_config; an explicit flag can break loading
#   --enforce-eager      disables CUDA graphs -> much slower; debug only
