# =============================================================================
#  model.env  —  everything specific to serving
#  orcarouter/Qwen3.8-27B-Uncensored-NVFP4 on this box.
#  Sourced after common/box.env; := so a real env var still wins for one-offs:
#     MAX_MODEL_LEN=65536 ./serve start
#
#  STATUS (2026-10-04): just added, NOT yet smoke-tested. Every tuned-looking
#  knob below is an INHERITED STARTING POINT copied from
#  models/qwen3.8-27b-nvfp4/model.env (same base architecture, same mixed
#  FP8/NVFP4 scheme) — re-verify against this checkpoint's own startup log
#  before trusting any of it, same rule as every other model in this repo.
#
#  WHAT THIS IS: the orcarouter uncensored/abliterated derivative of
#  Qwen/Qwen3.8-27B, quantized to the same mixed precision as
#  qwen3.8-27b-nvfp4 (confirmed from this checkpoint's own config.json
#  quantization_config): linear_attn.{in_proj_qkv,in_proj_z,out_proj} (GDN
#  attention layers) = FP8, mlp.{gate,up,down}_proj = NVFP4 group_size=16.
#  ~23.0 GiB weights across the 5 main shards + 1 extra shard (summed from
#  the HF repo file listing, not yet cross-checked against
#  model.safetensors.index.json's own total_size field).
#
#  DIFFERENT FROM qwen3.8-27b-nvfp4 in one way worth knowing: that checkpoint
#  uses NVIDIA ModelOpt's quantization_config format; THIS checkpoint uses
#  the compressed-tensors format (config_groups / recipe.yaml) — a different
#  but also vLLM-supported encoding of the same NVFP4 scheme. Should still
#  auto-detect correctly (same rule as every quantized model here: don't
#  pass --quantization, read from the checkpoint), but unverified until the
#  first real start — if quant-kernel selection looks wrong in the startup
#  log, this format difference is the first thing to check.
#
#  NOT THE SAME MODEL as qwen3.8-27b-nvfp4: that's NVIDIA's stock/
#  non-abliterated release. This is orcarouter's uncensored/abliterated
#  derivative — same org + same base license (Apache 2.0) as this box's
#  existing qwen3.8-27b-fp8, just a different (lighter) quantization of it.
#  Gated HF repo — needs the account behind HF_TOKEN to have already clicked
#  "Agree and access repository" for THIS specific repo (separate gate from
#  qwen3.8-27b-fp8's, even though it's the same publisher/org).
#
#  ROLE: a third on-demand gb10-reasoning member alongside qwen3.8-27b-fp8
#  (uncensored, FP8, currently the uncensored go-to) and gpt-oss-120b. NOT
#  boot-enabled, NOT the default — added so there's an uncensored NVFP4
#  option alongside the stock one, nothing more yet. Only one gb10-reasoning
#  member can run at a time (shared port 8000) — stop whichever is currently
#  running first.
#
#  Model-card facts / open questions: notes.md
# =============================================================================

# llmctl: chat/vision, uncensored NVFP4 -- DEFAULT (boot)
# -- identity ------------------------------------------------------------- #
: "${MODEL:=orcarouter/Qwen3.8-27B-Uncensored-NVFP4}"   # GATED -- see header
: "${SERVED_NAME:=gb10-reasoning}"  # shared identity w/ qwen3.8-27b-fp8 + qwen3.8-27b-nvfp4 + gpt-oss-120b (port 8000). Never co-resident with any of them.
# CONTAINER defaults to  vllm-<slug>  ;  PORT is per-model so several can coexist
: "${PORT:=8000}"   # shared "gb10-reasoning" port -- 8001=gb10-embedding, 8004=gb10-writing

# -- image override: same xgrammar024 requirement as the other qwen3.8-27b checkpoints #
if [ "${VLLM_IMAGE}" = "nvcr.io/nvidia/vllm:26.07-py3" ]; then
  VLLM_IMAGE="vllm-qwen:26.07-xgrammar024"
fi

# -- architecture facts (not tunable — same base model as qwen3.8-27b-nvfp4) #
#  Qwen3_5ForConditionalGeneration -- 64 layers, hybrid attention (16 full +
#  48 Gated-DeltaNet linear, interval 4), native vision + video tower, MTP
#  head (mtp_num_hidden_layers=1). Identical shape to qwen3.8-27b-nvfp4; only
#  the base weights (uncensored vs stock) and the quant_config ENCODING
#  (compressed-tensors vs ModelOpt) differ. Do NOT pass --quantization --
#  read from the checkpoint's quantization_config, same rule as every other
#  quantized model here.

# -- GDN Triton autotuner workaround (APPLIED PROACTIVELY, not rediscovered) #
#  Same linear_attn FP8 kernel path as qwen3.8-27b-fp8 / qwen3.8-27b-nvfp4,
#  both of which hit (or proactively avoided) a device-side assert / OOM in
#  this exact Triton GDN path on GB10/SM121 (vLLM #36598/#33857). Apply the
#  fix from the first start rather than waiting to crash into it.
: "${DOCKER_ENV:=VLLM_TRITON_FORCE_FIRST_CONFIG=1}"

# -- tuned serving knobs (INHERITED starting points from qwen3.8-27b-nvfp4, see notes.md) #
: "${MAX_MODEL_LEN:=131072}"     # 2026-10-30: 262144 -> 131072 (user: gb10-writing has priority, its KV gets the memory)
: "${MTP_TOKENS:=3}"             # inherited; re-check spec_accept_len at first real run
: "${KV_CACHE_DTYPE:=fp8}"       # inherited; --kv-cache-dtype nvfp4 needs sm100f, this box is sm121
: "${GPU_MEM_UTIL:=0.26}"        # 2026-10-30: 0.32 -> 0.26, budget only (KV is fixed below): measured 24.7 GiB
                                  # non-KV + 5.5 GiB KV = 30.2 of 31.6 GiB. 2026-10-10: 0.52 -> 0.32 to run next to gb10-writing (0.52 gave 35.6 GiB KV
                                  # = ~1M tokens, far more than needed; 0.32 measured: 291k tokens KV). Was: CONSERVATIVE starting guess, same as qwen3.8-27b-nvfp4 at its
                                  # own smoke-test stage -- refine from the real "Available KV
                                  # cache memory:" startup log line, don't skip straight to a
                                  # higher value (see the 2026-09-10 OOM-crash-loop incident).
                                  # >>> any other gb10-reasoning member must be stopped first. <<<
: "${MAX_NUM_SEQS:=32}"          # inherited starting guess (one agent harness, not batch workload)

# -- vision / multimodal ------------------------------------------------- #
: "${LANGUAGE_MODEL_ONLY:=0}"
: "${MM_IMAGE_LIMIT:=1}"
: "${MM_VIDEO_LIMIT:=0}"

# -- serving parser plugins (inherited, VERIFY at smoke test) ------------ #
: "${REASONING_PARSER:=qwen3}"
: "${TOOL_CALL_PARSER:=qwen3_coder}"

# -- misc -------------------------------------------------------------- #
: "${STARTUP_TIMEOUT:=1200}"

# -- moe-backend / EXTRA_VLLM_ARGS -------------------------------------- #
#  Untested for this checkpoint's quant ENCODING (compressed-tensors, not
#  ModelOpt) -- qwen3.8-27b-nvfp4's smoke test found `auto` picks
#  FlashInferCutlassNvFp4LinearKernel for the ModelOpt encoding; unverified
#  whether `auto` resolves the same way for compressed-tensors NVFP4. Check
#  the startup log at first run before assuming this transfers.
: "${EXTRA_VLLM_ARGS:=}"

# -- fixed KV cache size (2026-10-30) ------------------------------------- #
#  Profiling on unified memory is unreliable next to siblings (one boot gave
#  32.9 GiB KV = 928k tokens, ~20 GiB over this model's share, starving
#  gb10-writing). Fixed instead: one 131072-token sequence needs ~4.7 GiB
#  (11.76 GiB held 330,975 tokens), 5.5 GiB leaves a little room for prefix
#  caching and short parallel requests.
EXTRA_VLLM_ARGS+="${EXTRA_VLLM_ARGS:+ }--kv-cache-memory-bytes $((11 * 512 * 1024 ** 2))"

# -- prefix caching: ON (inherited default) ------------------------------ #
: "${PREFIX_CACHING:=1}"

# -- enforce-eager: same fallback lever as the other qwen3.8-27b models -- #
: "${ENFORCE_EAGER:=0}"

# NOT set on purpose:
#   --quantization        read from the checkpoint's quantization_config; an explicit flag can break loading
