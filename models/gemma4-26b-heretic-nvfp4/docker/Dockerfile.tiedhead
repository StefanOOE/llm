# Patched vLLM image for Gemma 4 ModelOpt-NVFP4 checkpoints (tied lm_head):
# a 2-site patch of vllm/.../quantization/modelopt.py, see
# patch_modelopt_tied_head.py. Still needed in NGC 26.11 (vLLM 0.33); the
# script asserts the old code, so a build fails once upstream fixes it.
#
# Build:
#   docker build -t vllm-gb10:26.11-tiedhead \
#     -f models/gemma4-26b-heretic-nvfp4/docker/Dockerfile.tiedhead \
#     models/gemma4-26b-heretic-nvfp4/docker
#
# Rollback image (26.07 lacks xgrammar >= 0.2.4, so it builds on the repo's
# xgrammar image): --build-arg BASE=vllm-qwen:26.07-xgrammar024
#   -t vllm-gb10:26.07-xg024-tiedhead
ARG BASE=nvcr.io/nvidia/vllm:26.11-py3
FROM ${BASE}
COPY patch_modelopt_tied_head.py /tmp/
RUN python3 -I /tmp/patch_modelopt_tied_head.py && rm /tmp/patch_modelopt_tied_head.py
