# =============================================================================
#  model.env  —  everything specific to serving
#  nvidia/Qwen3.8-27B-NVFP4 on this box.
#  Sourced after common/box.env; := so a real env var still wins for one-offs:
#     MAX_MODEL_LEN=65536 ./serve start
#
#  STATUS: smoke-tested + full bench/matrix.yaml sweep 2026-09-14
#  (gap_close_nvfp4), now the DEFAULT gb10-reasoning member. The sweep
#  confirmed MTP_TOKENS=3 and KV_CACHE_DTYPE=fp8 below as the right choices
#  for THIS checkpoint (not just inherited from qwen3.8-27b-fp8) -- see
#  notes.md "Full bench sweep results" for the numbers. --kv-cache-dtype
#  nvfp4 does not work on this hardware (needs sm100f, box is sm121);
#  flashinfer_b12x forced as --linear-backend also fails (no kernel for the
#  FP8 linear_attn layers) -- auto's pick already beats FP8 substantially.
#
#  WHAT THIS IS: the OFFICIAL NVIDIA ModelOpt NVFP4 quantization of the STOCK
#  (non-abliterated) Qwen/Qwen3.8-27B -- mixed precision, verified from the
#  checkpoint's own hf_quant_config.json: linear_attn.{in_proj_qkv,in_proj_z,
#  out_proj} (the GDN attention layers) = FP8, mlp.{gate,up,down}_proj =
#  NVFP4 (group_size 16). ~21.9 GiB weights (vs the FP8 checkpoint's
#  ~28.95 GiB) -- real but modest (~24%) memory saving, since only the
#  MLP/expert weights actually shrink to 4-bit.
#
#  NOT THE SAME MODEL as qwen3.8-27b-fp8: this is Qwen's stock release, not
#  orcarouter's uncensored/abliterated derivative. Refusals are back on --
#  a real, accepted trade-off (see "DEFAULT since 2026-09-14" below), not an
#  oversight.
#
#  DEFAULT since 2026-09-14: promoted from smoke-tested candidate to the
#  live gb10-reasoning member after the smoke test showed a clean start,
#  ~24% smaller weights, and rough single-stream throughput (18-26 tok/s)
#  clearly above the FP8 checkpoint's tuned ~14 tok/s baseline (2 casual
#  samples, not a full sweep -- see notes.md "Smoke test results"). No
#  formal "default" flag exists in this repo; in practice it means this is
#  the instance actually running/started first for gb10-reasoning.
#  qwen3.8-27b-fp8 stays available on-demand for when uncensored/stock-
#  refusal behavior matters more than raw speed.
#
#  Model-card facts / open questions: notes.md
# =============================================================================

# llmctl: chat/vision, stock
# -- identity ------------------------------------------------------------- #
: "${MODEL:=nvidia/Qwen3.8-27B-NVFP4}"   # public repo (readable without a token; NVIDIA org)
: "${SERVED_NAME:=gb10-reasoning}"  # shared identity w/ qwen3.8-27b-fp8 + gpt-oss-120b (port 8000) -- see llmctl/README. Never co-resident with either. DEFAULT member since 2026-09-14.
# CONTAINER defaults to  vllm-<slug>  ;  PORT is per-model so several can coexist
: "${PORT:=8000}"   # shared "gb10-reasoning" port -- 8001=gb10-embedding, 8004=gb10-writing

# -- image override: same xgrammar024 requirement as qwen3.8-27b-fp8 (tool
#    calling needs xgrammar >=0.2.4; base NGC 26.07 ships 0.2.0). See that
#    model.env / docker/Dockerfile.xgrammar024 for the full story.
if [ "${VLLM_IMAGE}" = "nvcr.io/nvidia/vllm:26.07-py3" ]; then
  VLLM_IMAGE="vllm-qwen:26.07-xgrammar024"
fi

# -- architecture facts (not tunable — same base model as qwen3.8-27b-fp8) - #
#  Qwen3_5ForConditionalGeneration -- 64 layers, hybrid attention (16 full +
#  48 Gated-DeltaNet linear, interval 4), native vision + video tower, MTP
#  head (mtp_num_hidden_layers=1). Identical shape to the FP8 checkpoint;
#  only the weight precision differs (see header). Do NOT pass
#  --quantization -- read from the checkpoint's quantization_config
#  (ModelOpt MIXED_PRECISION), same rule as every other quantized model here.

# -- GDN Triton autotuner workaround (APPLIED PROACTIVELY, not rediscovered) #
#  qwen3.8-27b-fp8/model.env hit a device-side assert / OOM on this exact
#  GDN linear-attention Triton kernel path on 2026-09-10 (vLLM #36598/#33857
#  -- GB10/SM121 isn't warmed during V1 profiling, so the first real GDN
#  prefill fires the Triton autotuner with no memory left). This checkpoint
#  keeps linear_attn at FP8 (same kernel path, untouched by the NVFP4
#  conversion of the MLP weights), so the SAME bug almost certainly applies.
#  Apply the fix from the first start rather than waiting to crash into it.
#  Full writeup: qwen3.8-27b-fp8/model.env "GDN Triton autotuner workaround".
: "${DOCKER_ENV:=VLLM_TRITON_FORCE_FIRST_CONFIG=1}"

# -- tuned serving knobs (INHERITED starting points, see notes.md) -------- #
#  1. Context 262144: native ceiling, no YaRN needed. Deliberately raised
#     2026-09-15 from the previous 131072 -- lower max_concurrency for the
#     same KV pool (fewer/shorter concurrent requests fit) and a bigger
#     cold-start profiling peak (2026-09-10 OOM-crash-loop territory) are
#     the accepted trade-offs. Not yet re-verified at this setting --
#     restart and check the "Available KV cache memory:" / "Maximum
#     concurrency" startup log lines before trusting it in production.
: "${MAX_MODEL_LEN:=262144}"
#  Previous value, in case 262144 proves too tight on KV/concurrency:
# : "${MAX_MODEL_LEN:=131072}"

#  2. MTP 3 draft tokens: qwen3.8-27b-fp8's tuned value (prod_mtp_sweep_65k).
#     NOT yet re-verified for this checkpoint -- MTP head is architecturally
#     present (mtp_num_hidden_layers=1) but its own weight precision /
#     accept-rate under NVFP4 MLP weights is unknown. Re-check accept_len in
#     the first bench run before trusting this default.
: "${MTP_TOKENS:=3}"

#  3. KV cache dtype fp8: the safe, proven starting point (matches
#     qwen3.8-27b-fp8). This vLLM build also lists a literal `nvfp4`
#     --kv-cache-dtype choice (unique relevance here, unlike the FP8
#     checkpoint) -- worth an A/B if this model is pursued past the smoke
#     test, not assumed correct/working yet.
: "${KV_CACHE_DTYPE:=fp8}"

#  4. gpu-memory-utilization 0.52: CONSERVATIVE starting guess, deliberately
#     lower than qwen3.8-27b-fp8's tuned 0.58 even though this checkpoint's
#     weights are ~7 GiB smaller (~21.9 vs ~28.95 GiB) -- the 2026-09-10
#     OOM-crash-loop incident (qwen3.8-27b-fp8/model.env, notes.md
#     "2026-09-10") was caused by starting too close to the pool ceiling and
#     losing the race against the cold-start transient peak (weight load +
#     checkpoint-into-page-cache + profiling + graph capture all at once).
#     Don't repeat that mistake on an unbenchmarked checkpoint. Refine from
#     the actual "Available KV cache memory:" startup log line once it's
#     been smoke-tested, same as every other model in this repo.
#     >>> qwen3.8-27b-fp8 / gpt-oss-120b must be stopped first (shared port). <<<
: "${GPU_MEM_UTIL:=0.52}"

#  5. max-num-seqs 32: qwen3.8-27b-fp8's tuned saturation point, inherited
#     as a starting guess (same architecture, same deployment shape --
#     one agent harness, not a batch workload).
: "${MAX_NUM_SEQS:=32}"

# -- vision / multimodal ------------------------------------------------- #
#  Same vision tower as qwen3.8-27b-fp8 (image_token_id / video_token_id
#  present in config.json). Loaded by default, matching the FP8 checkpoint.
: "${LANGUAGE_MODEL_ONLY:=0}"
: "${MM_IMAGE_LIMIT:=1}"
: "${MM_VIDEO_LIMIT:=0}"

# -- serving parser plugins (inherited from the model card / qwen3.8-27b-fp8) #
: "${REASONING_PARSER:=qwen3}"           # thinking ON by default; toggle per request
: "${TOOL_CALL_PARSER:=qwen3_coder}"     # Qwen3-Coder XML tool-call format -- VERIFY at smoke test
                                          # (not yet confirmed this checkpoint's chat template matches)

# -- misc -------------------------------------------------------------- #
: "${STARTUP_TIMEOUT:=1200}"     # ~22 GiB weights -- smaller than qwen3.8-27b-fp8's 28.95 GiB, so this should be generous

# -- moe-backend / EXTRA_VLLM_ARGS -------------------------------------- #
#  Qwen3_5 is confirmed MoE + hybrid attention. `auto` is untested for THIS
#  checkpoint's NVFP4 weights -- check the startup log for which
#  --moe-backend / --linear-backend it actually selects. This box's vLLM
#  build has a `flashinfer_b12x` backend explicitly documented as "FlashInfer
#  CuteDSL fused MoE for SM12x (RTX Pro 6000 / DGX Spark)" for NVFP4 -- i.e.
#  purpose-built for this exact chip + quant format (unlike gpt-oss's MXFP4,
#  which flashinfer_b12x explicitly rejects). If `auto` doesn't pick it,
#  try forcing it by hand first:
#    EXTRA_VLLM_ARGS="--moe-backend flashinfer_b12x --linear-backend flashinfer_b12x"
#  Empty until verified which (if either) is actually needed/better.
: "${EXTRA_VLLM_ARGS:=}"

# -- prefix caching: ON (inherited default) ------------------------------ #
#  qwen3.8-27b-fp8's benchmarked win (prefix_cache_ab: -25/-27% TTFT, +22%
#  throughput) should transfer architecturally -- not yet re-verified here.
: "${PREFIX_CACHING:=1}"

#  --enforce-eager: same fallback lever as qwen3.8-27b-fp8 -- only helps a
#  separate CUDA-graph GDN bug (#37431), not the autotuner OOM above (that's
#  what DOCKER_ENV is for). Keep off unless the autotuner workaround alone
#  still crashes.
: "${ENFORCE_EAGER:=0}"

# NOT set on purpose:
#   --quantization        read from the checkpoint's quantization_config (ModelOpt); an explicit flag can break loading
