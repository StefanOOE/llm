# =============================================================================
#  model.env  —  everything specific to serving  openai/gpt-oss-120b  on this box.
#  Sourced after common/box.env; := so a real env var still wins for one-offs:
#     MAX_MODEL_LEN=65536 EXTRA_VLLM_ARGS="--moe-backend marlin" ./serve start
#
#  STATUS: scaffolded 2026-08-29, weights downloading. Every numeric default
#  below is a starting point, NOT yet a benchmark result — unlike
#  qwen3.8-27b-fp8/model.env. Run the bench/matrix.yaml sweep once weights are
#  in place and replace these with the winning config (see notes.md TODO).
#  Model-card facts / SM121 gotchas / sources: notes.md
# =============================================================================

# -- identity ------------------------------------------------------------- #
: "${MODEL:=openai/gpt-oss-120b}"        # public repo, Apache 2.0, no HF_TOKEN needed
: "${SERVED_NAME:=gpt-oss-120b}"         # model id clients pass
# CONTAINER defaults to  vllm-<slug>  ;  PORT is per-model so several can coexist
: "${PORT:=8002}"

# -- local-path override: our weight download deliberately excludes metal/
#    and original/ (see README's `hf download --exclude` command -- vLLM
#    only needs the HF-format safetensors). vLLM 0.24.0's get_model_path()
#    still calls HF's snapshot_download() even with HF_HUB_OFFLINE=1, which
#    raises IncompleteSnapshotError for those 11 "missing" files -- observed
#    2026-08-31, first real start attempt. Its fast path
#    (`if os.path.exists(model): return model`) skips that check entirely
#    for a local path, so resolve the cached snapshot dir on the host (same
#    HF cache layout vLLM itself uses) and hand vLLM the container-side path
#    via lib.sh's VLLM_MODEL_PATH. $MODEL itself stays the repo id -- it's
#    still what preflight() and `hf download` use.
if [ -z "${VLLM_MODEL_PATH:-}" ]; then
  _gpt_oss_ref="${HF_CACHE:-/home/ss/models/hf-cache}/hub/models--openai--gpt-oss-120b/refs/main"
  if [ -f "${_gpt_oss_ref}" ]; then
    VLLM_MODEL_PATH="/hf-cache/hub/models--openai--gpt-oss-120b/snapshots/$(cat "${_gpt_oss_ref}")"
  fi
  unset _gpt_oss_ref
fi

# -- architecture facts (not tunable, just why the knobs below look this way) #
#  MoE, 128 experts / 4 active, 36 layers, native MXFP4 (quant_method=mxfp4 in
#  the checkpoint's quantization_config — do NOT pass --quantization, same rule
#  as qwen's FP8: read from config.json, an explicit flag can break loading).
#  ~63 GiB of weights (vs qwen's 28 GiB) — no MTP head (Qwen3.8's speculative
#  decoding does not apply here), no vision tower (text-only).

# -- tuned serving knobs (PENDING BENCHMARK — see notes.md) --------------- #
#  1. Context: native 131072 via YARN (rope_scaling factor 32 from a
#     4096 base). Half the layers are sliding-window (window=128) — long
#     context should be cheaper here than on qwen's mostly-full-attention
#     stack, but that needs to be confirmed by the ctx-scaling sweep.
: "${MAX_MODEL_LEN:=65536}"

#  2. KV cache dtype: checkpoint carries no k/v_scale (like qwen-fp8), so start
#     on the safe default (bf16) and let the sweep show whether fp8 KV is
#     worth the same accuracy caveat it had there.
: "${KV_CACHE_DTYPE:=auto}"

#  3. gpu-memory-utilization: ~63 GiB of weights alone is ~49% of the 128 GB
#     unified pool. 0.85 -> ~109 GB carved, ~46 GB left for KV/activations,
#     ~19 GB host headroom. Tighten once the sweep shows real KV pool needs.
#     >>> RUNNING A SECOND MODEL: lower this so the sum + host still fits. <<<
: "${GPU_MEM_UTIL:=0.85}"

#  4. max-num-seqs: conservative starting point; several DGX-Spark community
#     writeups land best-single-user throughput around max-num-seqs 1-4 on
#     this exact box (memory-bandwidth-bound MoE), which disagrees with
#     qwen's saturation point of 32 — needs its own sweep, not a copy-paste.
: "${MAX_NUM_SEQS:=8}"

# -- speculative decoding: NOT SUPPORTED for gpt_oss in vLLM (no MTP/EAGLE
#    head shipped with this checkpoint). Always 0; kept only because lib.sh
#    reads it unconditionally.
: "${MTP_TOKENS:=0}"

# -- vision / multimodal: gpt-oss-120b is text-only, there is no tower to
#    load or skip either way — LANGUAGE_MODEL_ONLY=1 is a no-op here but is
#    the semantically correct setting (and avoids depending on the mm-limit
#    codepath for a model with zero declared modalities).
: "${LANGUAGE_MODEL_ONLY:=1}"
: "${MM_IMAGE_LIMIT:=0}"
: "${MM_VIDEO_LIMIT:=0}"

# -- serving parser plugins (from the model card / vLLM's gpt_oss support) - #
: "${REASONING_PARSER:=openai_gptoss}"   # Harmony-format reasoning channel
: "${TOOL_CALL_PARSER:=openai}"          # Harmony-format tool calls

# -- SM121 (GB10) MXFP4 caveat — VERIFIED 2026-08-31, does not reproduce -- #
#  Multiple community reports (vLLM 0.16-0.20 era, NGC 26.0x) describe the
#  default MoE backend picking an SM80-only Marlin MXFP4 kernel on SM121,
#  which corrupts the *first* Harmony control token -> every response comes
#  back with content=null / reasoning=null even though tokens were generated.
#  Smoke-tested on this box (0.24.0 / NGC 26.07): auto DOES pick Marlin
#  (confirmed in the server log), yet content/reasoning came back non-null
#  and coherent across 5 requests (plain chat + tool-calling, repeated).
#  The bug does not reproduce here -- EXTRA_VLLM_ARGS stays empty. Details
#  + the escalation order below (now just a documented fallback in case a
#  future image/driver update regresses this) in notes.md.
#  NOTE: --moe-backend flashinfer_b12x (--help=all's "SM12x/DGX Spark"
#  label) looked like the obvious candidate but is NOT valid for MXFP4 --
#  vLLM rejects it at startup ("not supported for MXFP4 MoE"). Don't use it;
#  flashinfer_cutlass is the real flashinfer option for this quant scheme
#  (untested so far, in bench/matrix.yaml's backend_sweep).
#    EXTRA_VLLM_ARGS="--moe-backend marlin --attention-backend TRITON_ATTN"
#  Sources: github.com/vllm-project/vllm issue #37030 (root cause), NVIDIA
#  DGX-Spark dev forum threads on gpt-oss-120b MXFP4, recipes.vllm.ai/openai/gpt-oss-120b.
: "${EXTRA_VLLM_ARGS:=}"

# -- misc -------------------------------------------------------------- #
: "${STARTUP_TIMEOUT:=1800}"     # 63 GiB of weights -> longer cold load than qwen's 28 GiB

# NOT set on purpose:
#   --quantization mxfp4      read from the checkpoint's config.json; setting it may break things (same rule as qwen's fp8)
#   --enforce-eager           disables CUDA graphs -> much slower; debug only
