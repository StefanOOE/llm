# =============================================================================
#  model.env  —  everything specific to serving
#  llmfan46/gemma-4-26B-A4B-it-qat-q4_0-uncensored-heretic-NVFP4 on this box.
#  Sourced after common/box.env; := so a real env var still wins for one-offs:
#     MAX_MODEL_LEN=32768 ./serve start
#
#  STATUS (2026-10-10): smoke-tested + compared (story, saga, 12-turn RP,
#  tools, code, refusals) -- see notes.md. 0.22 -> 18.13 GiB weights,
#  4.9 GiB KV = 202k tokens. Needs the patched image (below).
#
#  WHAT THIS IS: Google Gemma 4 26B-A4B-it (QAT q4_0 "unquantized" release),
#  decensored by llmfan46 with Heretic v1.2 (ARA, attn.o_proj only; card:
#  11/100 refusals vs 100/100, KL 0.06), NVFP4 by ModelOpt (hf_quant_config,
#  group 16; vision, router, first layers excluded). MoE: 128 experts, top-8,
#  ~4B active, 30 layers -- 25 sliding-window (1024) + 5 full attention with
#  only 2 KV heads (head_dim 512) -> ~20 KB KV per token, long context is
#  cheap. Vision tower, thinking mode, native tool calling.
#
#  ROLE: gb10-writing (port 8004) -- German stories / interactive roleplay,
#  uncensored. Runs IN PARALLEL with gb10-reasoning (qwen3.8), gb10-embedding
#  and gb10-rendering (ComfyUI), so it is sized small. Only uncensored
#  variants qualify for this role.
#
#  Model-card facts / open questions: notes.md
# =============================================================================

# llmctl: German writing, uncensored, MoE NVFP4
# -- identity ------------------------------------------------------------- #
: "${MODEL:=llmfan46/gemma-4-26B-A4B-it-qat-q4_0-uncensored-heretic-NVFP4}"
: "${SERVED_NAME:=gb10-writing}"   # stable identity for writing clients; room for a later swap
: "${PORT:=8004}"                  # 8000=gb10-reasoning, 8001=gb10-embedding, 8002=gb10-rendering (8003 was gb10-code, removed)
: "${VLLM_MODEL_PATH:=/hf-cache/local/gemma4-26b-heretic-nvfp4}"   # plain HF-layout download (curl), not the hub cache
: "${TRUST_REMOTE_CODE:=0}"        # Gemma4ForConditionalGeneration is native in vLLM 0.24

# -- image override: tied-lm_head ModelOpt fix (+ xgrammar 0.2.4), see docker/ #
#  Stock 26.07 crashes at load: NotImplementedError in tie_weights (excluded
#  ParallelLMHead gets UnquantizedLinearMethod). Build: docker/Dockerfile.tiedhead
if [ "${VLLM_IMAGE}" = "nvcr.io/nvidia/vllm:26.07-py3" ]; then
  VLLM_IMAGE="vllm-gb10:26.07-xg024-tiedhead"
fi

# -- serving knobs (starting points) ------------------------------------ #
: "${MAX_MODEL_LEN:=262144}"     # native max (2026-10-10: 131072 -> 262144, user); KV ~25 KB/token measured
: "${MTP_TOKENS:=0}"             # no MTP head in this checkpoint
: "${KV_CACHE_DTYPE:=auto}"      # KV is tiny anyway; avoid fp8-KV surprises on SM121
: "${GPU_MEM_UTIL:=0.26}"        # 0.22: 4.9 GiB KV = 202k tok (128k ctx). 262144 ctx needs 5.67 GiB KV; 0.24 gave only 5.17 -> 0.26 gave 13.75 GiB = 635k tok.
                                  # Refine from "Available KV cache memory", don't go straight higher.
: "${MAX_NUM_SEQS:=8}"

# -- vision / multimodal ------------------------------------------------- #
: "${LANGUAGE_MODEL_ONLY:=0}"
: "${MM_IMAGE_LIMIT:=1}"
: "${MM_VIDEO_LIMIT:=0}"

# -- serving parser plugins ---------------------------------------------- #
: "${REASONING_PARSER:=gemma4}"
: "${TOOL_CALL_PARSER:=gemma4}"

# -- misc -------------------------------------------------------------- #
: "${STARTUP_TIMEOUT:=1800}"
: "${PREFIX_CACHING:=1}"
: "${ENFORCE_EAGER:=0}"

# -- thinking ON by default (user wants the visible reasoning) ------------ #
#  2026-10-10: on a long (~88k) agent-harness session the thinking phase looped
#  "(End of thought)" / "(End)" INSIDE the reasoning channel (never emitted
#  <channel|>). User keeps it on anyway; requests can turn it off with
#  chat_template_kwargs {"enable_thinking": false}. Possible guard if it
#  recurs: --reasoning-config + per-request thinking_token_budget.
#  (not the := form: the JSON's closing brace would end ${...} early)
[ -n "${EXTRA_VLLM_ARGS:-}" ] || EXTRA_VLLM_ARGS='--default-chat-template-kwargs {"enable_thinking":true}'

# NOT set on purpose:
#   --quantization        read from hf_quant_config.json (modelopt NVFP4)
