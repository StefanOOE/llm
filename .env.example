# Copy to .env. Box-wide secrets only. common/serve.sh reads API_KEY and HF_TOKEN
# from here (a models/<slug>/model.env may override API_KEY per model). Every
# tuning value lives in common/box.env (hardware) or models/<slug>/model.env.

# Default endpoint auth key. Generate with:  openssl rand -hex 32
API_KEY=

# Hugging Face token with access to the gated model repos.
HF_TOKEN=
