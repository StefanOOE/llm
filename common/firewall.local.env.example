# Copy to common/firewall.local.env (git-ignored) and fill in.
# Read by common/setup-firewall.sh; it aborts if this file or a value is missing.

# Operator workstation: SSH/SCP (:22), DGX Dashboard (:8501), image bridge (:8002)
WORKSTATION_IP=192.0.2.10
# Agent harness server: LLM APIs (:8000/:8001/:8004), image bridge (:8002)
HARNESS_IP=192.0.2.20

# Optional: marker name of the rule block in /etc/ufw/after*.rules, and older
# marker names whose blocks should be stripped on the next run.
#FIREWALL_MARKER=LLM-SERVER-WHITELIST
#FIREWALL_LEGACY_MARKERS=
