# =============================================================================
#  model.env  —  everything specific to serving  BAAI/bge-m3  on this box.
#  Sourced after common/box.env; := so a real env var still wins for one-offs:
#     MAX_MODEL_LEN=4096 ./serve start
#
#  This is the box's first EMBEDDING model, not a chat model. It runs on vLLM's
#  pooling runner and is reached at  POST /v1/embeddings  (OpenAI-compatible),
#  NOT /v1/chat/completions. See notes.md for the model-card facts.
# =============================================================================

# llmctl: embeddings (litellm proxy)
# -- identity ----------------------------------------------------------- #
: "${MODEL:=BAAI/bge-m3}"          # public repo, MIT, no HF_TOKEN needed
: "${SERVED_NAME:=bge-m3}"         # model id clients pass
# CONTAINER defaults to  vllm-<slug>  ;  PORT is per-model so several coexist
: "${PORT:=8001}"                  # 8000 = qwen3.8-27b-fp8, 8002 = gpt-oss-120b

# -- runner: pooling / embeddings ------------------------------------------ #
#  vLLM 0.24.0 dropped `--task embed`; the mode is `--runner pooling`
#  (--runner {auto,draft,generate,pooling}). lib.sh's RUNNER=pooling branch
#  emits a deliberately minimal flag set and skips every generate-only flag
#  (parsers, tool-choice, kv-cache-dtype, MTP, mm-limits) — so this model.env
#  does not set MTP_TOKENS / KV_CACHE_DTYPE / MAX_NUM_SEQS / REASONING_PARSER /
#  TOOL_CALL_PARSER / MM_* / LANGUAGE_MODEL_ONLY at all.
: "${RUNNER:=pooling}"

# -- serving knobs ---------------------------------------------------------- #
#  1. Context 8192: bge-m3's native maximum. It is an XLM-RoBERTa encoder whose
#     position embeddings were extended to 8194 (config.json max_position_
#     embeddings) — no rope-scaling, just the flag. Inputs longer than this are
#     truncated by vLLM.
: "${MAX_MODEL_LEN:=8192}"

#  2. dtype bfloat16: the HF checkpoint is fp32. bf16 halves the weight/activation
#     footprint (~1.1 GiB weights) with no measurable retrieval-quality cost and
#     is the native compute dtype on GB10. lib.sh passes --dtype only when != auto.
: "${DTYPE:=bfloat16}"

#  3. gpu-memory-utilization 0.12: ~15 GB of the 128 GB unified pool. bge-m3 is
#     only ~568M params (~1.1 GiB bf16 + activations), so this is a generous
#     ceiling, not a target. The point is to stay small next to the 27B chat
#     instance: qwen3.8-27b-fp8 runs at 0.65, so 0.65 + 0.12 = 0.77, ~0.23 of
#     the pool left for the host. Drop to 0.08 if vLLM ever complains about
#     free memory at startup; do NOT raise qwen's 0.65.
: "${GPU_MEM_UTIL:=0.12}"

#  4. enforce-eager OFF (repo convention: CUDA graphs stay on; "--enforce-eager
#     is debug only"). Set ENFORCE_EAGER=1 only if a start shows memory pressure
#     from CUDA-graph capture — the model is tiny, so this should not be needed.
: "${ENFORCE_EAGER:=0}"

# -- pooling / normalization: NOT set on purpose ------------------------- #
#  bge-m3 ships 1_Pooling/config.json (CLS pooling) and sentence_bert_config.json
#  / config_sentence_transformers.json (normalize=true). vLLM reads these
#  automatically. Do NOT hand-set --pooler-config or --convert unless a test
#  shows the vectors are wrong (e.g. un-normalized, or wrong dim).

# -- misc -------------------------------------------------------------- #
#  STARTUP_TIMEOUT MUST match qwen3.8-27b-fp8 (1200). `serve install-service`
#  regenerates the SHARED template unit /etc/systemd/system/llm-vllm@.service
#  with TimeoutStartSec / ExecStartPost-timeout = this value; a smaller number
#  would shorten qwen's cold-boot window too. bge-m3 itself loads in well under
#  a minute, so the ceiling is harmless.
: "${STARTUP_TIMEOUT:=1200}"

# NOT set on purpose:
#   VLLM_IMAGE override   — the stock NGC image (box.env) is enough; the
#                           xgrammar bump is a chat/tool-calling fix, irrelevant here.
#   --trust-remote-code   — bge-m3 is a native vLLM-supported architecture (XLM-RoBERTa).
