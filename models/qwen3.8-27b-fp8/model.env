# =============================================================================
#  model.env  —  everything specific to serving
#  orcarouter/Qwen3.8-27B-Uncensored-FP8 on this box.
#  Sourced after common/box.env; := so a real env var still wins for one-offs:
#     MAX_MODEL_LEN=32768 MTP_TOKENS=3 ./serve start
#
#  Every default below is a benchmark result. Full tables + rationale:
#     bench/results/overnight_20260827_191752/report.md   (report.html for charts)
#     bench/results/ab_lmonly_20260828_143816/             (vision A/B)
#     43 runs, vLLM 0.24.0 (NGC 26.07), one GB10, 2026-08-27/28.
#     bench/results/{prod_mtp_sweep_65k,kv_dequant_cliff_check,
#       prefix_cache_ab,seqs_sweep_ext_65k,moe_backend_probe}_*/
#     gap-closing sweep at the REAL production context, 2026-08-31/09-01 --
#     see notes.md "2026-09-01" section for the full writeup.
#  Model-card facts / gotchas: notes.md
# =============================================================================

# -- identity ------------------------------------------------------------- #
: "${MODEL:=orcarouter/Qwen3.8-27B-Uncensored-FP8}"   # gated HF repo id
: "${SERVED_NAME:=qwen3.8-27b-uncensored}"            # model id clients pass
# CONTAINER defaults to  vllm-<slug>  ;  PORT is per-model so several can coexist
: "${PORT:=8000}"

# -- image override: base NGC 26.07 ships xgrammar==0.2.0, but vLLM 0.24.0's
#    tool-calling path imports normalize_tool_choice (added in xgrammar
#    0.2.4) -> every request with "tools" -> HTTP 500. Patched, --no-deps
#    (transformers/torch untouched). Build: docker/Dockerfile.xgrammar024.
#    Fallback if 26.07 shows other tool-calling quirks: rebase on 26.06.
#    NOTE: box.env already sets VLLM_IMAGE via ":=", so a plain ":=" here
#    would be a no-op (var is non-empty by the time this line runs). Only
#    replace it if it's still box.env's stock default -- that way a real
#    env var set for a one-off (VLLM_IMAGE=... ./serve start) still wins.
if [ "${VLLM_IMAGE}" = "nvcr.io/nvidia/vllm:26.07-py3" ]; then
  VLLM_IMAGE="vllm-qwen:26.07-xgrammar024"
fi

# -- tuned serving knobs ------------------------------------------------- #
#  1. FP8 weights, not BF16:  1.4-1.9x faster here (bandwidth-bound box;
#     28 GB weights beat 50 GB, and FP8 leaves a bigger KV pool).
#
#  2. MTP speculative decoding, 3 draft tokens (changed from 2, 2026-09-01):
#     original 0-4 sweep (below) ran at max_model_len=32768 and picked 2 as
#     the batch-32 winner -- but the shipped default was never re-verified
#     at the REAL production context (65536) or against the deployment's
#     actual shape (one remote agent, not 32 concurrent users). Re-swept
#     (prod_mtp_sweep_65k, 2026-08-31) at max_model_len=65536, gmu=0.65,
#     max_num_seqs=32:
#       N   1-stream  batch8  codegen  sat32 | accept-len
#       2     13.03    85.14   94.48   209.1  |    2.1-2.5
#       3     14.43    86.51   87.29  210.21  |    2.6-2.8   <- picked
#     3 wins single-stream (+11%, the deployment-representative metric),
#     ties on batch8/saturate32, loses ~8% on codegen_decode (long output).
#     Accept-length consistently higher for 3. Net: 3 fits the actual
#     single-agent traffic shape better than the old batch-tuned default.
#     Original 32768-ctx sweep, for reference (0 disables, costs ~1.5-1.7x):
#       N   1-stream  batch8  codegen  sat32 | accept-len  accept-rate
#       0      7.3     50.3    50.7    150.6  |     -            -
#       1     10.4     69.8    74.1    176.3  |    1.77        77%
#       2     11.8     78.9    88.4    183.1  |    2.38        69%
#       3     12.3     79.1    81.4    181.1  |    2.73        58%
#       4     11.7     72.1    79.2    177.7  |    3.04        51%   (never best)
: "${MTP_TOKENS:=3}"

#  3. Context length 65536 (2026-08-30, raised from 16384): the remote Hermes
#     agent hard-requires >=64000. Native max_position_embeddings is 262144
#     (config.json) -> no YaRN/rope-scaling needed, just raise the flag.
#     CORRECTED 2026-09-01: this comment previously claimed the 64k table
#     row below was "still valid, same GPU_MEM_UTIL/MAX_NUM_SEQS" -- false,
#     that row was measured at gpu_memory_utilization=0.80/max_num_seqs=6
#     (bench-only settings), not production's 0.65/32. The production combo
#     (65536 + 0.65 + 32) had never actually been load-tested together until
#     prod_mtp_sweep_65k (2026-08-31): it works fine, no OOM, no seqs
#     ceiling hit -- see the MTP block above for the throughput numbers at
#     this exact combo (that sweep IS the validation).
#     Original context-scaling table (bench-only 0.80/0.85 gmu, reduced
#     max_num_seqs per row -- NOT the production combo, kept for the
#     shape of the curve only): throughput flat to 16k (~58 tok/s), -40% by
#     32k, TTFT 117 s at a 110k-token prompt. Values at:
#       ctx    out tok/s  TTFT p50  KV pool  max-conc(vLLM est)
#        16k     58.0      13.6 s   64 GiB      54x
#        32k     36.8      15.7 s   65 GiB      38x
#        64k     22.6      32.9 s   64 GiB      23x
#       256k     12.9     117.2 s   71 GiB       8x
: "${MAX_MODEL_LEN:=65536}"

#  4. FP8 KV cache: 46-64 GiB pool / ~40x concurrency (vs ~29 GiB / ~13x for
#     bf16 KV). Caveat: checkpoint has no k/v_scale -> scale 1.0, possible
#     minor accuracy cost, not measured. KV_CACHE_DTYPE=auto keeps bf16 KV.
#     RE-VERIFIED at real long context (2026-09-01, kv_dequant_cliff_check):
#     a GB10-specific report (llama.cpp/GGML KV quant) found KV quantization
#     can get SLOWER than f16 at deep context on this hardware's bandwidth-
#     rich unified memory ("dequantization cliff", dequant compute not
#     offset by bandwidth saved) -- worth checking since our own kv_sweep
#     above only used short workloads. Result at 65536 ctx (28k-token
#     prefix, 4k-token decode, ctx64k_load): fp8 28.52 tok/s / 63.2ms TPOT
#     vs auto 22.41 tok/s / 96.3ms TPOT -- fp8 wins decisively (+27%
#     throughput, -34% TPOT). The cliff does NOT reproduce for vLLM's fp8
#     KV cache (different kernel/quant scheme than GGML's blockwise dequant)
#     -- fp8 stays confirmed correct, no reversal.
: "${KV_CACHE_DTYPE:=fp8}"

#  5. gpu-memory-utilization 0.65: ~83 GB of the 128 GB unified pool; 'free'
#     shows ~87 GB used once ready, leaving the host ~40 GB. At 16k the KV
#     pool is oversized -> 0.50-0.55 is safe if you want more host memory.
#     >>> RUNNING A SECOND MODEL: lower this so the sum + host still fits. <<<
: "${GPU_MEM_UTIL:=0.65}"

#  6. max-num-seqs 32: the benchmarked saturation point (~183 tok/s aggregate,
#     ~5.7 tok/s per user at 32 concurrent). Extended past 32 (2026-09-01,
#     seqs_sweep_ext_65k, at the real 65536 ctx + 0.65 gmu):
#       seqs   saturate tok/s   ttft p50
#        32       202.64          2.4 s
#        48       246.32 (+22%)   4.8 s
#        64       285.47 (+16%)   4.9 s
#     Throughput keeps climbing through 64 (no ceiling hit, no regression);
#     the real cost of going higher is TTFT, not a hard limit. Stays at 32
#     -- this deployment is one agent, not a batch workload, so the extra
#     aggregate throughput at 48/64 isn't the bottleneck; bump it only if a
#     batchier traffic shape shows up and TTFT headroom allows it.
: "${MAX_NUM_SEQS:=32}"

# -- vision / multimodal ----------------------------------------------- #
#  9. Vision tower LOADED by default. A/B vs --language-model-only:
#       weight load  +0.9 GiB   |  startup  +161 s (one-time)  |  KV pool -1.3%
#       unified mem  +3.2 GB    |  text throughput: within run noise
#     OCR verified: full invoice image read verbatim in 6-7 s (~250 tokens).
#     LANGUAGE_MODEL_ONLY=1 skips it (saves ~3 GB + boot time, no images).
: "${LANGUAGE_MODEL_ONLY:=0}"
: "${MM_IMAGE_LIMIT:=1}"          # max images per request  (ignored if LMO=1)
: "${MM_VIDEO_LIMIT:=0}"          # max videos per request  (ignored if LMO=1)
# : "${MM_PROCESSOR_KWARGS:={\"max_pixels\": 1048576}}"   # cap image resolution

# -- serving parser plugins (from the model card) --------------------- #
: "${REASONING_PARSER:=qwen3}"           # thinking ON by default; toggle per request
#  Deliberately qwen3_coder, not hermes: this is the format the model card
#  documents and that lib.sh already pairs with --enable-auto-tool-choice
#  (always on, see lib.sh). The 2026-08-30 HTTP-500 bug (see VLLM_IMAGE above)
#  was xgrammar's import error, not a parser mismatch -- switching parsers
#  wouldn't have fixed it and would trade a documented-correct format for an
#  unverified one. Re-check against the model card before ever changing this.
: "${TOOL_CALL_PARSER:=qwen3_coder}"     # Qwen3-Coder XML tool-call format

# -- misc -------------------------------------------------------------- #
: "${STARTUP_TIMEOUT:=1200}"     # seconds to wait for /health (cold: weights + compile + vision)

# -- moe-backend / EXTRA_VLLM_ARGS -------------------------------------- #
#  Model is confirmed MoE + hybrid full/linear-attention (Qwen3_5, see
#  notes.md), so --moe-backend is a real axis, unlike a dense model.
#  Probed 2026-09-01 (moe_backend_probe): auto vs triton, mixed result
#  (triton +9.6% single-stream, -7.7% batch8_balanced) -- no compelling
#  win either way. triton manually curl-verified correct (non-null
#  content/reasoning/tool_calls) but not adopted; auto is also the
#  backend already proven in daily production use. Kept empty.
: "${EXTRA_VLLM_ARGS:=}"

# -- prefix caching: ON (2026-09-01) ------------------------------------ #
#  Benchmarked (prefix_cache_ab, 2026-08-31) against a workload shaped like
#  the actual deployment (6000-token shared system prompt/tool schema +
#  short varying turn -- not independent random prompts):
#    solo (conc=1):     off 12.16 tok/s / TTFT 3736ms  ->  on 12.12 tok/s / TTFT 2815ms (-25%)
#    parallel (conc=8):  off 52.05 tok/s / TTFT 4076ms  ->  on 63.52 tok/s / TTFT 2985ms (+22% tput, -27%)
#  Clear win, both latency and (under concurrency) throughput. Previously
#  undocumented/unwired -- lib.sh's generate runner had no dedicated knob
#  for this flag, and the OLD comment here wrongly asserted vLLM defaults
#  to off with MTP (never actually tested; live --help=all shows the real
#  default is None/auto). Now wired via lib.sh's PREFIX_CACHING var (same
#  pattern as DTYPE/ENFORCE_EAGER).
: "${PREFIX_CACHING:=1}"

# NOT set on purpose:
#   --quantization fp8        read from the checkpoint's config.json; setting it breaks things
#   --enforce-eager           disables CUDA graphs -> much slower; debug only
