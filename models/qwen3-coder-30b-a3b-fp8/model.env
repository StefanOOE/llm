# =============================================================================
#  model.env  —  everything specific to serving
#  Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8 on this box.
#  Sourced after common/box.env; := so a real env var still wins for one-offs:
#     MAX_MODEL_LEN=131072 ./serve start
#
#  STATUS: scaffolded 2026-09-02, weights downloading. Numeric defaults are
#  STARTING POINTS, not yet benchmark results -- run bench/matrix.yaml's
#  overnight suite and fold the winners in.
#
#  WHY THIS MODEL (not Qwen2.5-Coder-32B): a 32B *dense* FP8 model hit the
#  GB10 LPDDR5x memory-bandwidth wall in benchmarking -- ~147 ms/token /
#  ~6.7 tok/s single-stream, flat across every config (32 GiB of weights
#  streamed per token / ~217 GB/s effective). Qwen3-Coder-30B-A3B is MoE
#  (30.5B total / 3.3B active per token, 128 experts / 8 active) -> only a
#  fraction of the weights move per token, so it decodes several times
#  faster while being a stronger coder on most benchmarks. Same trade the
#  box already makes for qwen3.8-27b-fp8 and gpt-oss-120b (both MoE).
#  Model-card facts / gotchas / open questions: notes.md
# =============================================================================

# -- identity ----------------------------------------------------------- #
: "${MODEL:=Qwen/Qwen3-Coder-30B-A3B-Instruct-FP8}"   # public repo, Apache 2.0
: "${SERVED_NAME:=qwen3-coder-30b}"                   # model id clients pass
# CONTAINER defaults to  vllm-<slug>  ;  PORT is per-model so several coexist
: "${PORT:=8003}"   # 8000 qwen3.8, 8001 bge-m3, 8002 gpt-oss, 8003 here, 8004 deepseek-coder-v2-lite

# -- image override: tool calling needs xgrammar >=0.2.4 (same NGC packaging
#    bug + fix as qwen3.8-27b-fp8; see that model.env + docker/Dockerfile.
#    xgrammar024). Reused as-is. NOT registry-pullable -- rebuild from that
#    Dockerfile if the local image cache loses the tag. Only replaces
#    box.env's stock default so a one-off VLLM_IMAGE=... still wins.
if [ "${VLLM_IMAGE}" = "nvcr.io/nvidia/vllm:26.07-py3" ]; then
  VLLM_IMAGE="vllm-qwen:26.07-xgrammar024"
fi

# -- architecture facts (not tunable — context for the knobs below) ----- #
#  Qwen3MoeForCausalLM (qwen3_moe). 48 layers, hidden 2048, 128 experts /
#  8 active per token, moe_intermediate_size 768. 30.5B total / ~3.3B active.
#  GQA: 32 query heads / 4 KV heads, head_dim 128 -> cheap KV
#  (~48 KiB/token fp8 = 2*48*4*128*1 B). Full attention (no sliding window).
#  Context: native max_position_embeddings 262144, rope_scaling null,
#  rope_theta 1e7 -> NO YaRN needed, just raise the flag up to 262144.
#  Quant: quant_method fp8, e4m3, weight_block_size [128,128] -> BLOCK FP8,
#  the exact scheme qwen3.8-27b-fp8 uses (activation_scheme dynamic;
#  layernorms / MoE gates / lm_head stay BF16). Read from the checkpoint --
#  do NOT pass --quantization.
#  No MTP head (no speculative decoding). No vision tower.

# -- tuned serving knobs (STARTING POINT — see bench/matrix.yaml) ------- #
#  1. Context 262144 -- the native max, free to enable (no YaRN, no
#     degradation). The overnight context_scaling suite maps the tok/s +
#     TTFT + KV-pool curve; lower this if the memory budget or TTFT at deep
#     context turns out unreasonable for actual use (most coding contexts
#     are < 128k). GQA/4-KV-head KV cost: ~12 GiB per full-length 262144
#     sequence (fp8), ~6 GiB at 131072.
: "${MAX_MODEL_LEN:=262144}"

#  2. KV cache dtype fp8: STARTING POINT (mirrors qwen3.8 / gpt-oss). Block-
#     FP8 checkpoint, no k/v_scale -> scale 1.0, possible minor accuracy
#     cost, unmeasured. Sweep auto vs fp8 (kv_sweep).
: "${KV_CACHE_DTYPE:=fp8}"

#  3. gpu-memory-utilization 0.40: sized for "solo + bge-m3" -- qwen3.8-27b
#     is STOPPED while this model runs on-demand (see README). ~31 GiB
#     weights + KV pool + bge-m3's 0.12 + host. MoE weights are still all
#     resident (only compute is sparse), so weight footprint ~ a 30B dense.
#     Tune from the sweep's server_kv_cache_gib / mem_ready_mb.
#     >>> qwen3.8-27b-fp8 must be stopped before starting this model. <<<
: "${GPU_MEM_UTIL:=0.40}"

#  4. max-num-seqs 16: starting guess. MoE -> watch for regression past the
#     sweet spot (gpt-oss did; qwen3.8 kept climbing). Sweep 1/4/8/16/32.
: "${MAX_NUM_SEQS:=16}"

# -- no speculative decoding: no MTP/EAGLE head in this checkpoint ------- #
: "${MTP_TOKENS:=0}"

# -- vision / multimodal: text-only ------------------------------------- #
: "${LANGUAGE_MODEL_ONLY:=1}"
: "${MM_IMAGE_LIMIT:=0}"
: "${MM_VIDEO_LIMIT:=0}"

# -- serving parser plugins -------------------------------------------- #
#  Not a thinking model -> REASONING_PARSER empty (lib.sh omits the flag).
: "${REASONING_PARSER:=}"
#  Qwen3-Coder's native tool-call format has a dedicated vLLM parser
#  `qwen3_coder` (in this image's --tool-call-parser enum). The repo also
#  ships chat_template.jinja + qwen3coder_tool_parser.py. VERIFY at first
#  start that tool_choice:"auto" returns non-null tool_calls (Qwen2.5-Coder
#  failed this -- Qwen3-Coder is the model qwen3_coder was built for, so it
#  should work, but check). If the repo's embedded chat template misbehaves,
#  vLLM bundles /opt/vllm/vllm-src/examples/tool_chat_template_qwen3coder.jinja
#  -> pass via EXTRA_VLLM_ARGS="--chat-template <path>".
: "${TOOL_CALL_PARSER:=qwen3_coder}"

# -- prefix caching: ON (starting point) ------------------------------- #
#  Coding = large recurring context. Expected win (qwen3.8's prefix_cache_ab:
#  -25/-27% TTFT, +22% throughput; deepseek-coder's: -87% TTFT). Verify with
#  this model's prefix_cache_ab suite.
: "${PREFIX_CACHING:=1}"

# -- moe-backend / EXTRA_VLLM_ARGS ------------------------------------ #
#  MoE => --moe-backend is a real axis. box-wide VLLM_USE_DEEP_GEMM=0 rules
#  out deep_gemm. moe_backend_probe tries auto vs triton (correctness-gated;
#  flashinfer_cutlass rejected qwen3.8's block-FP8 MoE per vLLM #43507, so
#  likely the same here -- auto's pick is the baseline). Empty by default.
: "${EXTRA_VLLM_ARGS:=}"

# -- misc ------------------------------------------------------------- #
: "${STARTUP_TIMEOUT:=1200}"   # ~31 GiB weights

# NOT set on purpose:
#   --quantization fp8   read from the checkpoint's quantization_config
#   --enforce-eager      disables CUDA graphs -> much slower; debug only
#   rope / --hf-overrides  262144 is native, no scaling needed
