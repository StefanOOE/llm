# =============================================================================
#  box.env  —  the HARDWARE layer.
#  Facts about this machine (NVIDIA GB10 / DGX Spark), not about any model.
#  Sourced by common/serve.sh and common/bench/*.py BEFORE the per-model
#  models/<slug>/model.env, which can override anything here.
#  Every value uses := so a real environment variable wins over the default.
# =============================================================================

# NGC vLLM image: vLLM 0.24.0, CUDA 13.3, arm64. Bundles native qwen3_5 support.
: "${VLLM_IMAGE:=nvcr.io/nvidia/vllm:26.07-py3}"

# Shared host caches (content-addressed -> safe to share across models).
: "${HF_CACHE:=/home/ss/models/hf-cache}"        # host HF_HOME, holds the weights
: "${VLLM_CACHE:=/home/ss/models/vllm-cache}"    # torch.compile + CUDA-graph cache

# Total unified memory, for the "~X GB of Y" banner math and sanity checks.
# On GB10 the GPU pool IS system RAM: gpu-memory-utilization carves from this.
: "${BOX_UNIFIED_MEM_GB:=128}"

# systemd ordering for the generated unit(s).
: "${BOX_AFTER_UNITS:=docker.service nv-docker-gpus.service network-online.target}"

# MANDATORY on sm_121: DeepGEMM's UE8M0 FP8 path asserts "Unknown recipe" during
# kernel warmup. Set to 1 only if a future driver/vLLM fixes it.
: "${VLLM_USE_DEEP_GEMM:=0}"
