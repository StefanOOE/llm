# Copy to .env. Box-wide secrets only. common/serve.sh reads HF_TOKEN from here.
# Every tuning value lives in common/box.env (hardware) or models/<slug>/model.env.
#
# No API_KEY here: these vLLM endpoints run without application-level auth --
# access control is the host firewall + IP whitelist instead (see README).

# Hugging Face token with access to the gated model repos.
HF_TOKEN=
