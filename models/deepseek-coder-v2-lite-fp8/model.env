# =============================================================================
#  model.env  —  everything specific to serving
#  RedHatAI/DeepSeek-Coder-V2-Lite-Instruct-FP8 on this box.
#  Sourced after common/box.env; := so a real env var still wins for one-offs:
#     MAX_MODEL_LEN=65536 KV_CACHE_DTYPE=auto ./serve start
#
#  STATUS: benchmark-tuned 2026-09-02 (overnight sweep, 31 runs). Every knob
#  below is confirmed by the sweep -- see notes.md "Sweep results". Nothing
#  changed from the scaffold: the starting points were right, or forced by
#  what works on this box (KV dtype, MoE backend).
#  Model-card facts / gotchas / resolved issues: notes.md
# =============================================================================

# llmctl: fast coder
# -- identity ----------------------------------------------------------- #
: "${MODEL:=RedHatAI/DeepSeek-Coder-V2-Lite-Instruct-FP8}"   # public repo, DeepSeek license ("other")
: "${SERVED_NAME:=deepseek-coder-v2-lite}"                   # model id clients pass
# CONTAINER defaults to  vllm-<slug>  ;  PORT is per-model so several coexist
: "${PORT:=8004}"   # 8000 qwen3.8, 8001 bge-m3, 8002 gpt-oss, 8003 qwen2.5-coder-32b, 8004 here

# -- image: STOCK NGC (box.env default). The xgrammar >=0.2.4 bump the qwen
#    models need is only for tool calling ("tools" in the request), and this
#    checkpoint's chat template has NO tool support at all (see notes.md) —
#    tool calling is off, so the stock image is enough. If a custom
#    tool-calling chat template is ever added here, switch VLLM_IMAGE to
#    vllm-qwen:26.07-xgrammar024 (same conditional pattern as the qwen models).

# -- architecture facts (not tunable — context for the knobs below) ----- #
#  DeepseekV2ForCausalLM. MoE: 64 routed + 2 shared experts, 6 active/token,
#  27 layers, first_k_dense_replace=1 (layer 0 dense). ~16 GiB weights,
#  15.7B total / ~2.4B active params.
#  MLA attention (kv_lora_rank 512, qk_rope_head_dim 64, v_head_dim 128) —
#  KV cache is a small latent, NOT full per-head K/V. So KV cost per token is
#  tiny vs. a normal attention model; long context is cheap here.
#  Context: native max_position_embeddings 163840 with YaRN ALREADY BAKED
#  INTO the checkpoint config (rope_scaling type=yarn, factor 40,
#  original 4096) — NO --hf-overrides / rope flag needed, just set
#  MAX_MODEL_LEN <= 163840.
#  Quant: quant_method fp8, activation_scheme STATIC, lm_head not quantized.
#  Read from the checkpoint — do NOT pass --quantization.
#  No MTP head (MTP arrived with DeepSeek-V3) — no speculative decoding.
#  No vision.

# -- trust-remote-code OFF ------------------------------------------------ #
#  The checkpoint's config.json has an `auto_map` pointing at the ORIGINAL
#  deepseek-ai/DeepSeek-Coder-V2-Lite-Instruct repo's custom modeling code.
#  With --trust-remote-code + HF_HUB_OFFLINE=1, AutoConfig.from_pretrained
#  hard-fails ("couldn't connect to huggingface.co ... couldn't find them in
#  the cached files") trying to fetch configuration_deepseek.py — VERIFIED
#  on first start attempt 2026-09-01. vLLM has a native deepseek_v2 class and
#  does NOT need the remote code, so turn it off (lib.sh then omits the flag
#  and AutoConfig uses vLLM's own DeepseekV2Config).
: "${TRUST_REMOTE_CODE:=0}"

# -- tuned serving knobs (STARTING POINT — see bench/matrix.yaml) ------- #
#  1. Context 131072 — "wie aktueller Kontext" (matches qwen3.8's 131072).
#     Native ceiling is 163840; raise MAX_MODEL_LEN toward that only if a
#     real need shows up (MLA makes it cheap, so the sweep's context_scaling
#     suite is mostly a latency/throughput-curve question, not a memory one).
: "${MAX_MODEL_LEN:=131072}"

#  2. KV cache dtype auto (= bf16). `fp8_ds_mla` was tried first and FAILS
#     on this box (2026-09-01): "No valid attention backend found for cuda
#     ... kv_cache_dtype=fp8_ds_mla, use_mla=True. Reasons: {TRITON_MLA:
#     [kv_cache_dtype not supported], FLASHINFER_MLA_SPARSE_SM120: [requires
#     index_topk config]}". No MLA attention backend in this NGC image
#     supports fp8_ds_mla on SM121. plain `fp8` with MLA is also uncertain
#     (TRITON_MLA is the only working MLA backend here). MLA's KV latent is
#     tiny anyway (~576 elems/token), so fp8 KV saves little — `auto` is the
#     safe, correct default. mla_kv_check still A/Bs auto vs fp8.
: "${KV_CACHE_DTYPE:=auto}"

#  3. gpu-memory-utilization 0.30: sized for "solo + bge-m3". Only ~16 GiB
#     weights + cheap MLA KV, so this is generous, not tight. The sweep's
#     mem_ready_mb / server_kv_cache_gib will show whether this model is
#     small enough to ALSO run alongside a live qwen3.8-27b (0.65) + bge-m3
#     (0.12) — if 0.30 + 0.77 + host fits, it can stay resident; document
#     the finding in notes.md.
: "${GPU_MEM_UTIL:=0.30}"

#  4. max-num-seqs 8: starting guess. MoE models often regress past their
#     sweet spot (see gpt-oss-120b's seqs_sweep) — sweep 1/2/4/8/16.
: "${MAX_NUM_SEQS:=8}"

# -- no speculative decoding: V2 checkpoint, no MTP head ----------------- #
: "${MTP_TOKENS:=0}"

# -- vision / multimodal: text-only ------------------------------------- #
: "${LANGUAGE_MODEL_ONLY:=1}"
: "${MM_IMAGE_LIMIT:=0}"
: "${MM_VIDEO_LIMIT:=0}"

# -- serving parser plugins -------------------------------------------- #
#  Not a thinking model — REASONING_PARSER stays EMPTY (lib.sh omits the
#  flag entirely when empty).
: "${REASONING_PARSER:=}"
#  TOOL CALLING: NOT SUPPORTED by this checkpoint. Its chat template
#  only renders user/assistant/system turns in plain
#  "User: ... Assistant: ..." form — no `tools` block, no tool_calls.
#  A --tool-call-parser only parses model OUTPUT; it can't add tool defs to
#  a prompt the template ignores. So TOOL_CALL_PARSER stays EMPTY — lib.sh
#  omits --enable-auto-tool-choice entirely, and `tool_choice` requests are
#  honestly unsupported (vs. a parser guess that 500s or hallucinates).
#  Enabling it would need a custom --chat-template with tool support.
: "${TOOL_CALL_PARSER:=}"

# -- prefix caching: ON (starting point) ------------------------------- #
#  Same rationale as qwen2.5-coder-32b — coding = large recurring context.
#  Verify with this model's prefix_cache_ab suite.
: "${PREFIX_CACHING:=1}"

# -- tokenizer override (REQUIRED) ----------------------------------- #
#  The FP8 repo's tokenizer_config.json declares tokenizer_class
#  "LlamaTokenizer". transformers 5.6.1 then loads it as LlamaTokenizerFast,
#  which REPLACES tokenizer.json's own ByteLevel decoder with the Llama
#  metaspace decoder (Replace "▁"->" "). DeepSeek's vocab uses GPT-2 byte
#  markers (Ġ / Ċ), not "▁" -> every space and newline is silently dropped
#  from the output ("Helloworlddeffoo():"). VERIFIED 2026-09-01, standalone
#  and via vLLM. Fix: serve a corrected tokenizer dir --
#    - tokenizer.json          : verbatim from the model's own snapshot
#                                (identical to deepseek-ai's; carries the
#                                right ByteLevel decoder already)
#    - tokenizer_config.json   : ./tokenizer/tokenizer_config.json in this
#                                repo -- the FP8 repo's file with just
#                                tokenizer_class -> "PreTrainedTokenizerFast"
#                                (generic, so tokenizer.json's decoder wins)
#  staged into the mounted HF cache so the container can see it. See notes.md.
_ds_cfg="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/tokenizer/tokenizer_config.json"
_ds_ref="${HF_CACHE}/hub/models--${MODEL//\//--}/refs/main"
if [ -f "$_ds_cfg" ] && [ -f "$_ds_ref" ]; then
  _ds_dst="${HF_CACHE}/tokenizer-fixes/deepseek-coder-v2-lite"
  _ds_snap="${HF_CACHE}/hub/models--${MODEL//\//--}/snapshots/$(cat "$_ds_ref")"
  mkdir -p "$_ds_dst" && cp -f "$_ds_snap/tokenizer.json" "$_ds_cfg" "$_ds_dst"/
fi
unset _ds_cfg _ds_ref _ds_dst _ds_snap

# -- EXTRA_VLLM_ARGS ------------------------------------------------- #
#  Holds --tokenizer (above) plus any --moe-backend the sweep settles on.
#  MoE model => --moe-backend is a real axis; box-wide VLLM_USE_DEEP_GEMM=0
#  rules out deep_gemm. moe_backend_probe tries auto vs triton vs cutlass
#  (correctness-gated). `auto` currently picks FLASHINFER_CUTLASS + TRITON_MLA
#  attention (seen at startup) and needs no flag. Compact, space-separated,
#  no JSON (lib.sh word-splits this).
if [ -z "${EXTRA_VLLM_ARGS:-}" ]; then
  EXTRA_VLLM_ARGS="--tokenizer /hf-cache/tokenizer-fixes/deepseek-coder-v2-lite"
fi

# -- misc ------------------------------------------------------------- #
: "${STARTUP_TIMEOUT:=1200}"   # ~16 GiB weights — faster cold load than the 27B/32B models

# NOT set on purpose:
#   --quantization fp8    read from the checkpoint's quantization_config
#   --enforce-eager       disables CUDA graphs -> much slower; debug only
#   rope / --hf-overrides  YaRN is already in the checkpoint config (factor 40)
